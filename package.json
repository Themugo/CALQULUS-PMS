{
  "name": "calqulus-pms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "restore:drill": "bash scripts/restore-migrations-drill.sh",
    "probe:live": "node scripts/probe-live-schema.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:financial": "vitest run src/test/financial-integrity",
    "test:isolation": "vitest run src/test/isolation",
    "test:integration": "vitest run src/test/integration",
    "test:api-contracts": "vitest run src/test/api-contracts",
    "test:regression": "vitest run src/test/regression",
    "test:property-based": "vitest run src/test/property-based",
    "test:benchmarks": "vitest run src/test/benchmarks",
    "test:edge-cases": "vitest run src/test/edge-cases",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:load:payment": "k6 run src/load-tests/payment-callback.js",
    "test:load:statement": "k6 run src/load-tests/statement-generation.js",
    "test:load:messaging": "k6 run src/load-tests/messaging.js",
    "test:load:all": "k6 run src/load-tests/payment-callback.js && k6 run src/load-tests/statement-generation.js && k6 run src/load-tests/messaging.js",
    "test:all": "npm run test && npm run test:financial && npm run test:isolation && npm run test:integration && npm run test:api-contracts && npm run test:regression && npm run test:property-based && npm run test:benchmarks && npm run test:edge-cases",
    "test:critical": "npm run test && npm run test:integration && npm run test:regression && npm run test:edge-cases",
    "audit:prod": "node scripts/audit-production.mjs",
    "release:report": "node scripts/release-readiness-report.mjs",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:all && npm run build && npm audit --audit-level=high && npm run audit:prod",
    "preview": "vite preview",
    "audit:security-boundary": "node scripts/security-boundary-audit.mjs",
    "audit:cross-role": "node scripts/cross-role-isolation-audit.mjs",
    "audit:migration-chain": "node scripts/audit-migration-chain.mjs",
    "audit:final-security": "node scripts/audit-final-security.mjs"
  },
